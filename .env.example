# -----------------------------------------------------------------------------
# ARQUIVO DE EXEMPLO: CONFIGURAÇÕES DO CHURRASCO GREGO DA PATY
# -----------------------------------------------------------------------------
# Copie este arquivo para .env e preencha com suas chaves reais.
# Mantenha suas chaves em segredo! Nunca suba o arquivo .env para o GitHub.

# SUPABASE
# Encontre em: Settings -> API
VITE_SUPABASE_URL=hhttps://seuid.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# MERCADO PAGO
# Encontre em: Painel do Desenvolvedor -> Credenciais
# Produção: APP_USR-... / Teste: TEST-...
VITE_MP_ACCESS_TOKEN=seu-token-mercadopago-aqui

# CONFIGURAÇÕES DO APP
PORT=3000
NODE_ENV=production

# -----------------------------------------------------------------------------
# NOTAS DE SEGURANÇA:
# 1. Use o VITE_ prefixado para variáveis que precisam ir para o navegador.
# 2. Nunca coloque SERVICE_ROLE_KEY ou tokens de administrador no .env.example.
# -----------------------------------------------------------------------------